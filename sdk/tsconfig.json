{
  "compilerOptions": {
    "declaration": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist/cjs",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["src/index.ts", "generated/src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
